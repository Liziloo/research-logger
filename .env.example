# Path to your Obsidian vault target folder
VAULT_DIR=~/vault/PA-Zone

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# Security token (create a random string, must match the extension settings)
API_SECRET_TOKEN=replace_with_your_secure_token_here

# Server host/port
HOST=0.0.0.0
PORT=8766
