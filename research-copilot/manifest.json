{
  "manifest_version": 3,
  "name": "Research Copilot (Obsidian & Ollama)",
  "version": "1.1",
  "description": "Auto-captures records, image viewers, and research articles to Obsidian with local AI.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Research Copilot"
  },
  "background": {
    "service_worker": "background.js"
  }
}
