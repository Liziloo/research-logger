[Unit]
Description=Research Logger FastAPI Service (Obsidian & Ollama)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/research-logger
ExecStart=%h/research-logger/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8766
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
